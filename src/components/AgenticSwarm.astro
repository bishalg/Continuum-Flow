---
/**
 * AgenticSwarm.astro
 * Orchestrator component for the "Production Studio Swarm" model.
 * Modularized for early 2026 standards.
 */
import ParadigmShift from './agentic/ParadigmShift.astro';
import SwarmMap from './agentic/SwarmMap.astro';
import PerformanceMetrics from './agentic/PerformanceMetrics.astro';
import CriticLogic from './agentic/CriticLogic.astro';
---

<div class="agentic-swarm-container not-prose font-sans text-slate-800 dark:text-slate-200 pt-8">
  <!-- SECTION 1: THE PARADIGM SHIFT -->
  <ParadigmShift />

  <!-- SECTION 2: THE SWARM MAP (Visual Architecture) -->
  <SwarmMap />

  <!-- SECTION 3: PERFORMANCE METRICS -->
  <PerformanceMetrics />

  <!-- SECTION 4: THE FEEDBACK LOOP DETAIL -->
  <CriticLogic />

  <!-- 2026 UPGRADE: Reference Image Injection (New Section) -->
  <section class="mt-24 mb-12">
    <div class="bg-gradient-to-br from-indigo-500/10 to-purple-500/10 border border-indigo-500/20 rounded-3xl p-8 md:p-16 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4">
            <span class="bg-indigo-500 text-white text-[10px] font-bold px-3 py-1 rounded-full shadow-lg">2026 STANDARD</span>
        </div>
        
        <div class="max-w-3xl">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6">Reference Image Injection</h2>
            <p class="text-lg text-slate-600 dark:text-slate-300 mb-8 leading-relaxed">
                In 2026, text-only prompts are considered "Lossy." Continuum Flow now mandates **Visual Anchoring** via Reference Image Injection. Every narrative chunk is generated with a locked "Identity Vector" derived from a master reference image.
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white dark:bg-slate-900/50 p-6 rounded-2xl border border-indigo-100 dark:border-indigo-900/30">
                    <h4 class="font-bold text-indigo-600 dark:text-indigo-400 mb-3 flex items-center gap-2">
                        <span>🖼️</span> Master Anchor
                    </h4>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        A single, high-fidelity image of the character that acts as the "Source of Truth" for all subsequent generations.
                    </p>
                </div>
                <div class="bg-white dark:bg-slate-900/50 p-6 rounded-2xl border border-purple-100 dark:border-purple-900/30">
                    <h4 class="font-bold text-purple-600 dark:text-purple-400 mb-3 flex items-center gap-2">
                        <span>🧬</span> Identity Encoding
                    </h4>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        IP-Adapter Plus and ControlNet Reference layers ensure that the character's facial features remain 100% consistent, even in dynamic action shots.
                    </p>
                </div>
            </div>
        </div>
    </div>
  </section>
</div>

<style is:global>
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25% { transform: translateY(-3px) rotate(-5deg); }
    50% { transform: translateY(0) rotate(0deg); }
    75% { transform: translateY(3px) rotate(5deg); }
  }
  .animate-bounce-slow {
    animation: bounce-slow 4s infinite ease-in-out;
    display: inline-block;
  }

  @keyframes pulse-border-sky {
    0%, 100% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0); }
    50% { box-shadow: 0 0 15px 0 rgba(14, 165, 233, 0.4); }
  }
  .animate-pulse-border-sky {
    animation: pulse-border-sky 3s infinite;
  }

  @keyframes pulse-border-white {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
    50% { box-shadow: 0 0 15px 0 rgba(255, 255, 255, 0.2); }
  }
  .animate-pulse-border-white {
    animation: pulse-border-white 3s infinite;
  }
</style>
